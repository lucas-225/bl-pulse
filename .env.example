# DATABASE_URL: MySQL / TiDB Cloud connection string for self-hosted Live-Action database
# Format: mysql://username:password@gateway01.region.prod.aws.tidbcloud.com:4000/test
# Falls back to fast in-memory catalog & analytics store automatically when empty
DATABASE_URL=""

# ADMIN_PASSWORD: Password for the /admin control panel, Market Auto-Sync engine, and Monetization dashboard
# Public visitors never need a password to browse or watch.
ADMIN_PASSWORD="blpulse2026"

# ENABLE_ADS: Toggle responsive display ad slots (Header, In-Feed, and Detail Page banners)
ENABLE_ADS="false"
ADSENSE_CLIENT_ID=""
ADSENSE_HEADER_SLOT=""
ADSENSE_INFEED_SLOT=""
ADSENSE_DETAIL_SLOT=""

# STREAMING & READING AFFILIATE PARTNER IDS (Automatically appended on 302 platform redirects)
GAGAOOLALA_REF=""
VIKI_AFFILIATE_ID=""
IQIYI_AFFILIATE_ID=""
WETV_AFFILIATE_ID=""
CRUNCHYROLL_AFFILIATE_ID=""
TAPAS_REF=""
LEZHIN_REF=""
TAPPYTOON_REF=""
MANTA_REF=""
BOOKWALKER_REF=""

# BL_PULSE_PUBLIC_ORIGIN: Optional canonical public HTTPS origin for SEO & sitemap.xml
BL_PULSE_PUBLIC_ORIGIN=""

# GEMINI_API_KEY / APP_URL: Standard AI Studio runtime variables (used for Market Auto-Sync & AI Auto-Fill)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
