# TMDB_READ_TOKEN or TMDB_API_KEY: Optional for live-action TMDB discovery & JustWatch provider lookups
TMDB_READ_TOKEN=""
TMDB_API_KEY=""

# DATABASE_URL: Optional MySQL connection string for persistent catalog storage (falls back to in-memory cache automatically)
DATABASE_URL=""

# BL_PULSE_PUBLIC_ORIGIN: Optional canonical public HTTPS origin for SEO & sitemap.xml
BL_PULSE_PUBLIC_ORIGIN=""

# GEMINI_API_KEY / APP_URL: Standard AI Studio runtime variables
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
